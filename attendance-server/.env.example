# Copy this file to .env and fill in real values.
# .env is loaded automatically on server startup (see app/config.py).

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost/attendance_db

# --- JWT signing secret (used to sign/verify login tokens) ---
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-char-hex-string

# --- SMTP (used to send password-reset emails) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME=Civil Engineering Attendance System

# --- Dashboard URL (used to build the link inside reset emails) ---
FRONTEND_URL=http://localhost:3000
